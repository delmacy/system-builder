{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://system-builder.local/contracts/task-contract-v1.schema.json",
  "title": "System Builder Task Metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "title", "status", "priority", "milestone", "model_tier", "risk",
    "architecture_impact", "executor_preference", "depends_on", "context_paths",
    "allowed_paths", "forbidden_paths", "max_files", "validation"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^TASK-[0-9]{3}(-[A-Z0-9-]+)?$" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "ready", "running", "verification", "completed", "blocked", "failed", "superseded"] },
    "priority": { "type": "integer", "minimum": 0 },
    "milestone": { "type": "string", "minLength": 1 },
    "model_tier": { "enum": ["free", "cheap", "architecture"] },
    "risk": { "enum": ["low", "medium", "high"] },
    "architecture_impact": { "type": "boolean" },
    "executor_preference": { "enum": ["opencode", "codex", "any"] },
    "depends_on": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "context_paths": { "$ref": "#/$defs/nonEmptyStringArray" },
    "allowed_paths": { "$ref": "#/$defs/nonEmptyStringArray" },
    "forbidden_paths": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "max_files": { "type": "integer", "minimum": 1, "maximum": 50 },
    "validation": { "$ref": "#/$defs/nonEmptyStringArray" }
  },
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
