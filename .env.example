# System Builder local environment configuration.
#
# Copy this file to `.env` and fill in values. `.env` is git-ignored and must
# never be committed with real credentials.
#
# ── Test databases ─────────────────────────────────────────────────────────
# The automated integration tests read these variables. When unset/blank the
# corresponding PostgreSQL tests skip; when set they must connect and pass.
# Reference CI values (GitHub Actions services) for a matching local setup:
#   trust service:  postgres://system_builder@127.0.0.1:5432/system_builder
#   SCRAM service:  postgres://deploy_auth:ci-test-password@127.0.0.1:5433/system_builder_auth
#
# Main trust-auth database used by Catalog/Release/Artifact/Deploy/Runtime tests.
SYSTEM_BUILDER_TEST_POSTGRES_URL=postgres://system_builder@127.0.0.1:5432/system_builder

# Authenticated (SCRAM-SHA-256) database used by the authenticated Deploy transport tests.
SYSTEM_BUILDER_TEST_AUTH_POSTGRES_URL=postgres://deploy_auth:change-me@127.0.0.1:5433/system_builder_auth

# ── Product dev/prod databases ─────────────────────────────────────────────
# Where the System Builder product persists (Factory + Deploy + autonomous
# Runtime). The raw transports support SCRAM-SHA-256 and TLS (sslmode), so
# authenticated databases work. Until a production split, dev and prod share
# one server; set separate hosts when they are split.
SYSTEM_BUILDER_DEV_POSTGRES_URL=postgres://admin:change-me@HOST:5433/system_builder_dev
SYSTEM_BUILDER_PROD_POSTGRES_URL=postgres://admin:change-me@HOST:5433/system_builder_prod
