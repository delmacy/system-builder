# System Builder local test environment configuration.
#
# Copy this file to `.env` and fill in values for your local PostgreSQL.
# `.env` is git-ignored and must never be committed.
#
# The product integration tests read these variables. When a variable is
# unset or blank, the corresponding PostgreSQL tests are skipped; when set,
# the tests connect to the given database and must pass.
#
# Reference CI values (GitHub Actions services) for matching a local setup:
#   trust service:    postgres://system_builder@127.0.0.1:5432/system_builder
#   SCRAM service:    postgres://deploy_auth:ci-test-password@127.0.0.1:5433/system_builder_auth
#
# Trust-auth database used by Catalog/Release/Artifact/Deploy/Runtime tests.
SYSTEM_BUILDER_TEST_POSTGRES_URL=postgres://system_builder@127.0.0.1:5432/system_builder

# Authenticated (SCRAM-SHA-256) database used by the authenticated Deploy
# transport tests. Leave blank to skip only the authenticated-path tests.
SYSTEM_BUILDER_TEST_AUTH_POSTGRES_URL=postgres://deploy_auth:change-me@127.0.0.1:5432/system_builder_auth
