{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@system-builder/catalog": [
        "packages/catalog/index.ts"
      ],
      "@system-builder/contracts/environment-profile": [
        "packages/contracts/environment-profile/index.ts"
      ],
      "@system-builder/contracts/factory-boundary": [
        "packages/contracts/factory-boundary/index.ts"
      ],
      "@system-builder/contracts/knowledge-boundary": [
        "packages/contracts/knowledge-boundary/public.ts"
      ],
      "@system-builder/contracts/process-versioning": [
        "packages/contracts/process-versioning/index.ts"
      ],
      "@system-builder/contracts/process-change": [
        "packages/contracts/process-change/index.ts"
      ],
      "@system-builder/contracts/decision-boundary": [
        "packages/contracts/decision-boundary/index.ts"
      ],
      "@system-builder/deterministic": [
        "packages/deterministic/index.ts"
      ],
      "@system-builder/runtime-core": [
        "packages/runtime-core/index.ts"
      ],
      "@system-builder/postgres": [
        "packages/postgres/index.ts"
      ]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "tooling/agent-harness/**/*.ts",
    "packages/**/*.ts",
    "tests/product/**/*.ts"
  ]
}
