{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@system-builder/contracts/environment-profile": [
        "packages/contracts/environment-profile/index.ts"
      ],
      "@system-builder/deterministic": [
        "packages/deterministic/index.ts"
      ],
      "@system-builder/runtime-core": [
        "packages/runtime-core/index.ts"
      ]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "tooling/agent-harness/**/*.ts",
    "packages/**/*.ts",
    "tests/product/**/*.ts"
  ]
}
