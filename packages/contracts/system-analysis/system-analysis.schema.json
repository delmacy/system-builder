{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://system-builder.local/contracts/system-analysis/1.0.0/system-analysis.schema.json",
  "title": "System Builder SystemAnalysis",
  "description": "Analysis bridge from approved BusinessRecipe requirements to capability matches, gaps, adaptations, integrations, security and sizing findings. This contract does not select a concrete runtime assembly.",
  "type": "object",
  "additionalProperties": false,
  "required": ["analysis", "analyzedAt", "recipeRef", "findings"],
  "properties": {
    "analysis": { "const": "SystemAnalysis" },
    "analyzedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "recipeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "version"],
      "properties": {
        "artifactId": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/finding" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "matched": { "type": "integer", "minimum": 0 },
        "gaps": { "type": "integer", "minimum": 0 },
        "adaptations": { "type": "integer", "minimum": 0 },
        "integrations": { "type": "integer", "minimum": 0 },
        "security": { "type": "integer", "minimum": 0 },
        "sizing": { "type": "integer", "minimum": 0 }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "statement", "recipeRequirementRefs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["match", "gap", "adaptation", "integration", "security", "sizing"]
        },
        "statement": { "type": "string", "minLength": 1 },
        "recipeRequirementRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "candidateCapabilityRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "constraints": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "severity": {
          "enum": ["info", "low", "medium", "high", "critical"]
        },
        "evidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
