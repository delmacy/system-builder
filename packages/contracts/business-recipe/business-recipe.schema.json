{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://system-builder.local/contracts/business-recipe/1.0.0/business-recipe.schema.json",
  "title": "System Builder BusinessRecipe",
  "description": "Approved technology-independent business behavior derived from observed ProcessMirror evidence. BusinessRecipe is intentionally distinct from SystemDefinition.",
  "type": "object",
  "additionalProperties": false,
  "required": ["recipe", "approvedAt", "sourceMirror", "modules", "rules", "responsibilities", "exceptions", "approvals"],
  "properties": {
    "recipe": { "const": "BusinessRecipe" },
    "approvedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "sourceMirror": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "version"],
      "properties": {
        "artifactId": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/module" }
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    },
    "responsibilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/responsibility" }
    },
    "exceptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/exception" }
    },
    "approvals": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/approval" }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "requirementIds", "evidenceRefs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "requirementIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "requirementIds", "evidenceRefs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "requirementIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "appliesWhen": { "type": "string" },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" }
      }
    },
    "responsibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "actor", "responsibility", "requirementIds", "evidenceRefs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "actor": { "type": "string", "minLength": 1 },
        "responsibility": { "type": "string", "minLength": 1 },
        "requirementIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "condition", "expectedHandling", "requirementIds", "evidenceRefs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "condition": { "type": "string", "minLength": 1 },
        "expectedHandling": { "type": "string", "minLength": 1 },
        "requirementIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "approvedBy", "approvedAt", "scope"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "approvedBy": { "type": "string", "minLength": 1 },
        "approvedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
        },
        "scope": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      }
    }
  }
}
