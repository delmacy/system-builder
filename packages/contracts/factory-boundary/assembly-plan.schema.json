{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://system-builder.local/contracts/factory-boundary/1.0.0/assembly-plan.schema.json",
  "title": "AssemblyPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "systemDefinitionRef", "components", "sourceRefs", "contentHash"],
  "properties": {
    "kind": { "const": "AssemblyPlan" },
    "systemDefinitionRef": { "type": "string", "minLength": 1 },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "provider", "version"],
        "properties": {
          "capability": { "type": "string", "minLength": 1 },
          "provider": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "contentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
