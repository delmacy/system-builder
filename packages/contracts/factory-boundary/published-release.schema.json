{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://system-builder.local/contracts/factory-boundary/1.0.0/published-release.schema.json",
  "title": "PublishedRelease",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "releaseId", "version", "artifactRef", "artifactHash", "validationEvidenceRef", "publishedAt"],
  "properties": {
    "kind": { "const": "PublishedRelease" },
    "releaseId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "artifactRef": { "type": "string", "minLength": 1 },
    "artifactHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "validationEvidenceRef": { "type": "string", "minLength": 1 },
    "publishedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["published", "deprecated", "archived"] }
  }
}
