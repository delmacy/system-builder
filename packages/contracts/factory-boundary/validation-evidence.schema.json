{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://system-builder.local/contracts/factory-boundary/1.0.0/validation-evidence.schema.json",
  "title": "ValidationEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "assemblyPlanRef", "decision", "checks", "evidenceHash"],
  "properties": {
    "kind": { "const": "ValidationEvidence" },
    "assemblyPlanRef": { "type": "string", "minLength": 1 },
    "decision": { "enum": ["PASS", "FAIL"] },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["PASS", "FAIL"] },
          "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "evidenceHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
