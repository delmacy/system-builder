{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://system-builder.local/contracts/system-definition/1.0.0/system-definition.schema.json",
  "title": "System Builder SystemDefinition",
  "description": "Technology-facing logical definition derived from SystemAnalysis. Business knowledge remains referenced, not collapsed into implementation, and environment secret values are structurally excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": ["definition", "analysisRef", "recipeRef", "entities", "processes", "actions", "capabilities", "views", "permissions", "policies", "integrations", "environmentRequirements"],
  "properties": {
    "definition": { "const": "SystemDefinition" },
    "analysisRef": { "type": "string", "minLength": 1 },
    "recipeRef": { "type": "string", "minLength": 1 },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "requirementRefs", "fields"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "requirementRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "type": { "enum": ["string", "number", "boolean", "date", "datetime", "json", "reference"] },
                "required": { "type": "boolean" },
                "referenceEntity": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "processes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "requirementRefs", "states"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "requirementRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "states": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "requirementRefs"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "requirementRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "capability", "requirementRefs"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "capability": { "type": "string", "minLength": 1 },
          "requirementRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "requirementRefs"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["list", "detail", "form", "dashboard", "timeline", "kanban", "calendar", "custom"] },
          "requirementRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "resource", "actions"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "resource": { "type": "string", "minLength": 1 },
          "actions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "requirementRefs"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "requirementRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "integrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "contract", "direction", "requirementRefs"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "contract": { "type": "string", "minLength": 1 },
          "direction": { "enum": ["inbound", "outbound", "bidirectional"] },
          "requirementRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "environmentRequirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "required"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["config", "secret-reference", "external-service", "storage", "database"] },
          "required": { "type": "boolean" },
          "description": { "type": "string" }
        },
        "not": { "required": ["value"] }
      }
    }
  }
}
