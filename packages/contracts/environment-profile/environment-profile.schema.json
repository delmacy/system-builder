{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://system-builder.local/contracts/environment-profile/1.0.0/environment-profile.schema.json",
  "title": "EnvironmentProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "environmentRef", "runtimeVersions", "bindings"],
  "properties": {
    "kind": { "const": "EnvironmentProfile" },
    "environmentRef": { "type": "string", "minLength": 1 },
    "runtimeVersions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "reference"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["config", "secret-reference"] },
          "reference": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
